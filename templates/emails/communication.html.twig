<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Komunikace</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #007bff;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 8px 8px 0 0;
        }
        .content {
            background-color: #f8f9fa;
            padding: 20px;
            border: 1px solid #dee2e6;
        }
        .footer {
            background-color: #6c757d;
            color: white;
            padding: 15px;
            text-align: center;
            border-radius: 0 0 8px 8px;
            font-size: 0.9em;
        }
        .info-section {
            margin: 20px 0;
            padding: 15px;
            background-color: white;
            border-left: 4px solid #007bff;
        }
        .info-row {
            margin: 8px 0;
        }
        .info-label {
            font-weight: bold;
            color: #495057;
        }
        .message-content {
            background-color: white;
            padding: 20px;
            border-radius: 4px;
            margin: 20px 0;
            white-space: pre-wrap;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Fakturační systém</h1>
        <p>Komunikace</p>
    </div>

    <div class="content">
        {% if supplier %}
            <div class="info-section">
                <h3>Dodavatel</h3>
                <div class="info-row">
                    <span class="info-label">Název:</span> {{ supplier.name }}
                </div>
                {% if supplier.invoiceEmail %}
                    <div class="info-row">
                        <span class="info-label">Email:</span> {{ supplier.invoiceEmail }}
                    </div>
                {% endif %}
                {% if supplier.telephone %}
                    <div class="info-row">
                        <span class="info-label">Telefon:</span> {{ supplier.telephone }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if client %}
            <div class="info-section">
                <h3>Klient</h3>
                <div class="info-row">
                    <span class="info-label">Název:</span> {{ client.name }}
                </div>
                {% if client.invoiceEmail %}
                    <div class="info-row">
                        <span class="info-label">Email:</span> {{ client.invoiceEmail }}
                    </div>
                {% endif %}
                {% if client.telephone %}
                    <div class="info-row">
                        <span class="info-label">Telefon:</span> {{ client.telephone }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if service %}
            <div class="info-section">
                <h3>Služba</h3>
                <div class="info-row">
                    <span class="info-label">Název:</span> {{ service.name }}
                </div>
                {% if service.description %}
                    <div class="info-row">
                        <span class="info-label">Popis:</span> {{ service.description }}
                    </div>
                {% endif %}
                <div class="info-row">
                    <span class="info-label">Frekvence:</span> 
                    {% if service.frequency == 'monthly' %}
                        Měsíčně
                    {% elseif service.frequency == 'quarterly' %}
                        Čtvrtletně
                    {% elseif service.frequency == 'yearly' %}
                        Ročně
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {% if invoice %}
            <div class="info-section">
                <h3>Faktura</h3>
                <div class="info-row">
                    <span class="info-label">Číslo faktury:</span> {{ invoice.invoiceNumber }}
                </div>
                <div class="info-row">
                    <span class="info-label">Datum vytvoření:</span> {{ invoice.dateCreated|date('d.m.Y') }}
                </div>
                <div class="info-row">
                    <span class="info-label">Datum splatnosti:</span> {{ invoice.dateDue|date('d.m.Y') }}
                </div>
            </div>
        {% endif %}

        <div class="message-content">
            <h3>Zpráva</h3>
            {{ communication.message|nl2br }}
        </div>

        {% if invoice %}
            <div class="info-section">
                <p><strong>Poznámka:</strong> Faktura je připojena jako příloha tohoto emailu.</p>
            </div>
        {% endif %}
    </div>

    <div class="footer">
        <p>Tento email byl automaticky vygenerován fakturačním systémem.</p>
        <p>Datum odeslání: {{ "now"|date('d.m.Y H:i') }}</p>
    </div>
</body>
</html>
