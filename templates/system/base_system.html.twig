<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Systém{% endblock %}</title>
  <link rel="stylesheet" href="/system/css/system.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    .bank-account-item {
      border: 1px solid #ddd;
      padding: 15px;
      margin-bottom: 10px;
      border-radius: 5px;
      background-color: #f9f9f9;
    }
    .bank-account-fields {
      position: relative;
    }
    .bank-selector-wrapper {
      margin-bottom: 15px;
    }
    .account-details {
      margin-top: 15px;
    }
    .form-row {
      display: flex;
      gap: 15px;
      margin-bottom: 10px;
    }
    .form-row .form-group {
      flex: 1;
    }
    .form-group {
      margin-bottom: 10px;
    }

    /* Nové styly pro správu bankovních účtů */
    .bank-accounts-management {
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 20px;
      background-color: #f9f9f9;
    }

    .existing-accounts-section {
      margin-bottom: 20px;
    }

    .existing-accounts-section label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
      color: #333;
    }

    .account-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .account-form-section {
      border-top: 1px solid #ddd;
      padding-top: 20px;
    }

    .account-form-section h5 {
      margin-bottom: 15px;
      color: #333;
      font-weight: 600;
    }

    .account-form-section .card {
      border: 1px solid #ddd;
      border-radius: 6px;
      background-color: #fff;
    }

    .account-form-section .card-body {
      padding: 20px;
    }

    .form-actions {
      display: flex;
      gap: 10px;
      justify-content: flex-start;
    }

    .btn-sm {
      padding: 0.375rem 0.75rem;
      font-size: 0.875rem;
      line-height: 1.5;
      border-radius: 0.25rem;
    }

    .btn-success {
      background-color: #28a745;
      border-color: #28a745;
      color: #fff;
    }

    .btn-success:hover {
      background-color: #218838;
      border-color: #1e7e34;
    }

    .btn-primary {
      background-color: #007bff;
      border-color: #007bff;
      color: #fff;
    }

    .btn-primary:hover {
      background-color: #0069d9;
      border-color: #0062cc;
    }

    .btn-secondary {
      background-color: #6c757d;
      border-color: #6c757d;
      color: #fff;
    }

    .btn-secondary:hover {
      background-color: #5a6268;
      border-color: #545b62;
    }

    .btn:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .form-check {
      display: flex;
      align-items: center;
      margin-bottom: 10px;
    }

    .form-check-input {
      margin-right: 8px;
      width: auto;
    }

    .form-check-label {
      margin-bottom: 0;
      cursor: pointer;
    }

    .mt-2 {
      margin-top: 0.5rem;
    }

    .mt-3 {
      margin-top: 1rem;
    }

    .mb-3 {
      margin-bottom: 1rem;
    }

    .col-md-6 {
      flex: 0 0 50%;
      max-width: 50%;
      padding-right: 7.5px;
      padding-left: 7.5px;
    }

    @media (max-width: 768px) {
      .form-row {
        flex-direction: column;
      }

      .col-md-6 {
        flex: 0 0 100%;
        max-width: 100%;
        padding-right: 0;
        padding-left: 0;
      }

      .account-actions {
        flex-direction: column;
      }

      .form-actions {
        flex-direction: column;
      }
    }
    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: 600;
    }
    .bank-code-input {
      max-width: 100px;
    }
    .checkbox-wrapper {
      display: flex;
      align-items: center;
      gap: 5px;
      margin: 10px 0;
    }
    .remove-bank-account {
      position: absolute;
      top: 0;
      right: 0;
    }
    .badge {
      display: inline-block;
      padding: 0.25em 0.4em;
      font-size: 75%;
      font-weight: 700;
      line-height: 1;
      text-align: center;
      white-space: nowrap;
      vertical-align: baseline;
      border-radius: 0.25rem;
    }
    .badge-primary {
      color: #fff;
      background-color: #007bff;
    }
    #add-bank-account {
      margin-top: 10px;
    }
  </style>
</head>
<body>
<header>
  <nav class="nav-left">
    <div>
      <img src="/images/logo.png" alt="Logo">
    </div>
    <div>
      <a href="{{ path('system_dashboard') }}">Dashboard</a>
      <a href="{{ path('client_index') }}">Klienti</a>
      <a href="{{ path('invoice_index') }}">Faktury</a>
      <a href="{{ path('service_index') }}">Služby</a>
    </div>
  </nav>
  <nav class="nav-right">
    <div>
      <a href="{{ path('supplier_index') }}">Dodavatelé</a>
      <a href="{{ path('app_logout') }}">Odhlásit se</a>
    </div>
  </nav>
</header>
<main>
  {% block body %}{% endblock %}
</main>
<footer>
  <p>&copy; {{ "now"|date("Y") }} Systémová administrace. Všechna práva vyhrazena.</p>
</footer>
</body>
</html>