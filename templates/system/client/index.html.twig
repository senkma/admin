{% extends 'system/base_system.html.twig' %}

{% block title %}Klienti{% endblock %}

{% block body %}


  <div class="table-container">
    <h2>Seznam klientů</h2>
    <a href="{{ path('client_create') }}" class="btn btn-primary">Vytvořit nového klienta</a>
  <table>
    <thead>
    <tr>
      <th>ID</th>
      <th>Jméno</th>
      <th>Adresa</th>
      <th>Telefon</th>
      <th>Email</th>
      <th>Splatnost</th>
      <th>Akce</th>
    </tr>
    </thead>
    <tbody>
    {% for client in clients %}
      <tr>
        <td>{{ client.id }}</td>
        <td>{{ client.name }}</td>
        <td>{{ client.street }} {{ client.number }}, {{ client.city }} {{ client.postalCode }}</td>
        <td>{{ client.telephone }}</td>
        <td>{{ client.invoiceEmail }}</td>
        <td>{{ client.dueDays }} dní</td>
        <td>
          <a href="{{ path('client_services', { id: client.id }) }}" class="btn" style="background-color: #17a2b8; color: white; margin-right: 0.5rem; padding: 0.375rem 0.625rem; text-decoration: none; border-radius: 0.25rem; font-size: 0.8rem;">
            🔧 Služby
          </a>
          <a href="{{ path('client_edit', { id: client.id }) }}" class="btn" style="background-color: #007bff; color: white; margin-right: 0.5rem; padding: 0.375rem 0.625rem; text-decoration: none; border-radius: 0.25rem; font-size: 0.8rem;">
            ✏️ Editovat
          </a>
          <form action="{{ path('client_delete', { id: client.id }) }}" method="post" style="display:inline;">
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="btn" style="background-color: #dc3545; color: white; padding: 0.375rem 0.625rem; border: none; border-radius: 0.25rem; font-size: 0.8rem; cursor: pointer;" onclick="return confirm('Opravdu chcete smazat tohoto klienta?')">
              🗑️ Smazat
            </button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr>
        <td colspan="7">Žádní klienti nebyli nalezeni.</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
{% endblock %}