<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <style>
    @font-face {
      font-family: 'DejaVu Sans';
      src: url('https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/fonts/DejaVuSans.ttf') format('truetype');
    }
    body {
      font-family: 'DejaVu Sans', Arial, sans-serif;
      margin: 0;
      padding: 0;
      color: #333;
      font-size: 0.8rem;
    }

    h1 {
      text-align: center;
      color: #000000; /* Modrá barva */
      margin-bottom: 10px;
    }

    h3 {
      margin-top: 0px; /* Nastavení odsazení od vrchu */
    }

    p {
      margin: 0; /* Odstranění odsazení */
    }

    .invoice-header {
      display: flex;
      justify-content: space-between;
      gap: 20px; /* Přidání mezery mezi boxy */
      margin-bottom: 20px;
    }

    .left, .right {
      float: left;
      width: 46%;
      height: auto;
      border: solid 1px #272727;
      padding: 10px;
      border-radius: 3px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      min-height: 220px; /* Nastavení minimální výšky */
    }

    .right {
      float: right;
    }

    .payment {
      border: solid 1px #272727;
      padding: 10px;
      border-radius: 3px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    table th, table td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }

    table th {
      background-color: #717171;
      color: white;
    }

    .total-row td {
      font-weight: bold;
      background-color: #f1f1f1;
    }

    .footer {
      text-align: center;
      margin-top: 30px;
      font-size: 0.9rem;
      color: #555;
    }

    .clearfix::after {
      content: "";
      display: table;
      clear: both;
    }
  </style>
  <title>Faktura č. {{ invoice.invoiceNumber }}</title>
</head>
<body>
<h1>Faktura č. {{ invoice.invoiceNumber }}</h1>
<div class="invoice-header clearfix">
  <div class="left">
    <h3>Dodavatel</h3>
    <p><b>{{ invoice.supplier.name }}</b></p>
    <p>{{ invoice.supplier.street }} {{ invoice.supplier.number }}</p>
    <p>{{ invoice.supplier.postalCode }} {{ invoice.supplier.city }}</p>
    <p>IČO: {{ invoice.supplier.ico }}</p>
    <p>DIČ: {{ invoice.supplier.dic }}</p>
    <br>
    <p><b>Kontakt:</b></p>
    <p>{{ invoice.supplier.telephone }}</p>
    <p>{{ invoice.supplier.invoiceEmail }}</p>
  </div>
  <div class="right">
    <h3>Odběratel</h3>
    <p><b>{{ invoice.client.name }}</b></p>
    <p>{{ invoice.client.street }} {{ invoice.client.number }}</p>
    <p>{{ invoice.client.postalCode }} {{ invoice.client.city }}</p>
    <p>IČO: {{ invoice.client.ico }}</p>
    <p>DIČ: {{ invoice.client.dic }}</p>
    <br>
    <p><b>Kontakt:</b></p>
    <p>{{ invoice.client.telephone }}</p>
    <p>{{ invoice.client.invoiceEmail }}</p>
  </div>
</div>

<div class="invoice-header">
  <div class="payment">
    <h3>Informace k platbě</h3>
    <p>Způsob úhrady: Bankovním převodem</p>
    <p>Bankovní účet: {{ invoice.supplier.bankAccount }}</p>
    <p>Variabilní symbol: {{ invoice.client.variableSymbol }}</p>
    <br>
    <p>Datum vytvoření: {{ invoice.dateCreated|date('d.m.Y') }}</p>
    <p>Datum splatnosti: {{ invoice.dateDue|date('d.m.Y') }}</p>
  </div>
</div>

<table>
  <thead>
  <tr>
    <th>Název položky</th>
    <th>Počet</th>
    <th>Cena za kus</th>
    <th>Celkem</th>
  </tr>
  </thead>
  <tbody>
  {% for item in invoice.items %}
    <tr>
      <td>{{ item.name }}</td>
      <td>{{ item.quantity }}</td>
      <td>{{ item.pricePerUnit|number_format(2, ',', ' ') }} Kč</td>
      <td>{{ (item.quantity * item.pricePerUnit)|number_format(2, ',', ' ') }} Kč</td>
    </tr>
  {% endfor %}
  <tr class="total-row">
    <td colspan="3">Cena celkem</td>
    <td>
      {{ invoice.items|reduce((carry, item) => carry + (item.quantity * item.pricePerUnit), 0)|number_format(2, ',', ' ') }} Kč
    </td>
  </tr>
  </tbody>
</table>

<div class="footer">
  <p>Faktura je generována automatickým systémem. V případě nesrovnalostí nás kontaktujte.</p>
  <p>Děkujeme za spolupráci!</p>
</div>
</body>
</html>