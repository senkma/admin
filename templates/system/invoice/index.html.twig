{% extends 'system/base_system.html.twig' %}

{% block title %}Seznam faktur{% endblock %}

{% block body %}
  <div class="table-container">
    <h2>Seznam faktur</h2>
    <label for="year-select">Vyberte rok:</label>
    <select id="year-select" class="form-control small-select" onchange="filterByYear(this.value)">
      {% for year in years %}
        <option value="{{ year }}" {% if year == currentYear %}selected{% endif %}>{{ year }}</option>
      {% endfor %}
    </select>
    <br><br>
    <a href="{{ path('invoice_create') }}" class="btn btn-primary">Vytvořit novou fakturu</a>

    <table>
      <thead>
      <tr>
        <th>ID</th>
        <th>Číslo faktury</th>
        <th>Dodavatel</th>
        <th>Klient</th>
        <th>Bankovní účet</th>
        <th>Datum vytvoření</th>
        <th>Datum splatnosti</th>
        <th>Celkem</th>
        <th>Akce</th>
      </tr>
      </thead>
      <tbody>
      {% set yearTotal = 0 %}
      {% for invoice in invoices %}
        {% set invoiceTotal = invoice.totalPrice %}
        {% set yearTotal = yearTotal + invoiceTotal %}
        <tr>
          <td>{{ invoice.id }}</td>
          <td>{{ invoice.invoiceNumber }}</td>
          <td>{{ invoice.supplier.name }}</td>
          <td>{{ invoice.client.name }}</td>
          <td>
            {% if invoice.bankAccount %}
              {{ invoice.bankAccount.fullAccountNumber }}
              {% if invoice.bankAccount.bankName %}
                ({{ invoice.bankAccount.bankName }})
              {% endif %}
            {% else %}
              <em>Není vybrán</em>
            {% endif %}
          </td>
          <td>{{ invoice.dateCreated|date('d.m.Y') }}</td>
          <td>{{ invoice.dateDue|date('d.m.Y') }}</td>
          <td class="invoice-total">{{ invoiceTotal|number_format(2, ',', ' ') }} Kč</td>
          <td>
            <a href="{{ path('invoice_edit', { id: invoice.id }) }}" class="btn btn-warning">Edit</a>
            <a href="{{ path('invoice_clone', { id: invoice.id }) }}" class="btn btn-secondary">Klonovat</a>
            <form action="{{ path('invoice_delete', { id: invoice.id }) }}" method="post" style="display:inline;">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn btn-danger" onclick="return confirm('Opravdu chcete smazat tuto fakturu?')">Delete</button>
            </form>
            <a href="{{ path('invoice_export_pdf', { id: invoice.id }) }}" class="btn btn-primary" target="_blank">Export PDF</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="9">Žádné faktury nebyly nalezeny.</td>
        </tr>
      {% endfor %}
      </tbody>
      {% if invoices|length > 0 %}
        <tfoot>
          <tr class="invoice-year-total">
            <td colspan="7">Součet{% if currentYear %} za rok {{ currentYear }}{% endif %}</td>
            <td class="invoice-total">{{ yearTotal|number_format(2, ',', ' ') }} Kč</td>
            <td></td>
          </tr>
        </tfoot>
      {% endif %}
    </table>
  </div>

  <script>
    function filterByYear(year) {
      const url = new URL(window.location.href);
      url.searchParams.set('year', year);
      window.location.href = url.toString();
    }
  </script>
{% endblock %}